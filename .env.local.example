# =============================================================================
# ASApp Atratizzi - Variaveis de Ambiente
# =============================================================================
# Copie para .env.local e preencha. .env.local NUNCA vai pro Git.

# --- NextAuth -----------------------------------------------------------------
# Gere com: openssl rand -base64 32   (um segredo NOVO, nao o do SApp)
AUTH_SECRET=
# Dev: http://localhost:3000 · Producao: https://<dominio-do-asapp>
AUTH_URL=http://localhost:3000

# --- Login Google (OAuth client "Web application") ------------------------------
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<dominio-do-asapp>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Claude -------------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Planilha (Service Account) -----------------------------------------------
# Compartilhe a planilha ASApp_Atratizzi com este e-mail como Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chave privada multilinha: entre aspas, com \n nas quebras
GOOGLE_SERVICE_ACCOUNT_KEY=
# ID da planilha ASApp_Atratizzi (o trecho entre /d/ e /edit na URL)
SHEETS_ASAPP_ID=

# --- Quem entra e com qual papel ------------------------------------------------
# diretoria | administrativo | producao_lider | operador | vendedor | socio
# ALLOWED_USERS='[{"email":"fulano@gmail.com","role":"diretoria"},{"email":"junior@gmail.com","role":"producao_lider"}]'
ALLOWED_USERS=
